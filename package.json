{
    "name": "autonomous-ai-chatbot",
    "version": "1.0.0",
    "description": "Autonomous AI Chatbot for your Store.",
    "main": "index.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "build-old": "webpack",
        "example": "webpack --config extensions/extensions.config.js --watch",
        "watch": "webpack --watch",
        "buildr": "cross-env NODE_ENV=production webpack",
        "build": "./bin/build.sh",
        "lint:js": "eslint src",
        "postbuild": "npm run i18n",
        "i18n": "npm run -s i18n:js && npm run -s i18n:check && npm run -s i18n:pot && npm run -s i18n:build && npm run i18n:json",
        "i18n:build": "php bin/combine-pot-files.php languages/autonomous-ai-chatbot.po languages/autonomous-ai-chatbot.pot",
        "i18n:check": "grunt checktextdomain",
        "i18n:js": "cross-env NODE_ENV=production babel src -o /dev/null",
        "i18n:json": "./bin/make-i18n-json.sh",
        "i18n:pot": "grunt makepot",
        "start": "webpack --watch",
        "zip": "./bin/zip.sh"
    },
    "author": "webkul",
    "license": "ISC",
    "devDependencies": {
        "@babel/cli": "^7.12.8",
        "@babel/core": "^7.0.0-0",
        "@babel/plugin-transform-async-to-generator": "7.7.4",
        "@babel/plugin-transform-react-jsx": "^7.18.6",
        "@babel/plugin-transform-runtime": "^7.24.7",
        "@babel/preset-env": "^7.24.8",
        "@babel/preset-stage-0": "^7.0.0",
        "@babel/runtime-corejs2": "7.7.7",
        "@wordpress/babel-plugin-import-jsx-pragma": "1.1.3",
        "@wordpress/babel-plugin-makepot": "2.1.3",
        "@wordpress/babel-preset-default": "3.0.2",
        "@wordpress/dependency-extraction-webpack-plugin": "^6.57.0",
        "autoprefixer": "^10.0.2",
        "babel-core": "7.0.0-bridge.0",
        "babel-loader": "8.0.6",
        "babel-plugin-transform-class-properties": "6.24.1",
        "babel-plugin-transform-es2015-template-literals": "6.22.0",
        "chalk": "2.4.2",
        "cross-env": "6.0.3",
        "css-loader": "3.4.0",
        "grunt": "^1.1.0",
        "grunt-checktextdomain": "1.0.1",
        "grunt-wp-i18n": "1.0.3",
        "mini-css-extract-plugin": "2.7.2",
        "node-watch": "0.6.3",
        "postcss": "^8.1.7",
        "postcss-color-function": "4.1.0",
        "postcss-loader": "^4.0.4",
        "sass": "1.34.0",
        "sass-loader": "10.1.1",
        "style-loader": "0.23.1",
        "webpack": "^5.104.1",
        "webpack-cli": "^5.1.4",
        "webpack-fix-style-only-entries": "0.3.1"
    },
    "dependencies": {
        "@babel/eslint-parser": "^7.15.8",
        "@ternlight/base": "^0.1.0",
        "@wordpress/hooks": "2.6.0",
        "@wordpress/i18n": "3.6.1",
        "@wordpress/postcss-plugins-preset": "^3.2.2",
        "@wordpress/postcss-themes": "1.0.5",
        "@xenova/transformers": "^2.17.2",
        "apexcharts": "^5.16.0",
        "html-react-parser": "^5.2.6",
        "i": "^0.3.7",
        "marked": "^17.0.1",
        "npm": "^11.6.2",
        "npm-watch": "^0.7.0",
        "openai-streams": "^6.2.0",
        "pinecone-io": "^1.0.0",
        "react-apexcharts": "^1.7.0",
        "react-hot-toast": "^2.6.0",
        "react-window": "^1.8.9",
